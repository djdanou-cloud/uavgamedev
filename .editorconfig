root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.{gd,gdshader}]
indent_style = tab
indent_size = 4
max_line_length = 100

[*.{tres,tscn,godot,cfg}]
indent_style = tab
insert_final_newline = false
trim_trailing_whitespace = false

[*.{py,yml,yaml,json,md,csv,svg}]
indent_style = space
indent_size = 4

[*.md]
trim_trailing_whitespace = false

[*.cmd]
end_of_line = crlf
